# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# The dev server (.claude/launch.json) sources `.env` so the CopilotKit runtime
# can pick the Anthropic adapter instead of the offline echo agent.

# Required for the live Ask Pi agent. Get one at https://console.anthropic.com
# (API Keys → Create Key). Starts with sk-ant-...
ANTHROPIC_API_KEY=

# Optional — overrides the default agent model.
# PI_AGENT_MODEL=claude-3-5-sonnet-latest
